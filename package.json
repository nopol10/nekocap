{
  "name": "nekocap",
  "version": "1.24.0",
  "description": "An awesome caption viewing and editing browser extension",
  "private": true,
  "scripts": {
    "build": "concurrently \"npm:build:ext\" \"npm:build:web\"",
    "build:ext:chrome": "tsx build-extension.ts --mode=prod --target=chrome",
    "build:ext:firefox": "tsx build-extension.ts --mode=prod --target=firefox",
    "build:ext": "npm run build:ext:chrome && npm run build:ext:firefox",
    "build:web": "ts-node-transpile-only export-font-list.ts && next build",
    "dev:ext": "tsx build-extension.ts --mode=development --target=chrome",
    "start:web": "next start",
    "start:web:prod": "node server.js",
    "test": "vitest run",
    "watch": "npm run watch:chrome",
    "watch:chrome": "concurrently \"npm:watch:ext:chrome\" \"npm:watch:web\"",
    "watch:firefox": "concurrently \"npm:watch:ext:firefox\" \"npm:watch:web\"",
    "watch:ext:chrome": "tsx build-extension.ts --mode=development --target=chrome --watch",
    "watch:ext:firefox": "tsx build-extension.ts --mode=development --target=firefox --watch",
    "watch:web": "next dev -p 12341 --experimental-https",
    "analyze:ext": "tsx build-extension.ts --mode=prod --target=chrome --analyze",
    "analyze:web": "cross-env ANALYZE=true npm run build:web",
    "lint": "eslint --ext .ts,.tsx ./src",
    "lint:fix": "eslint --ext .ts,.tsx --fix ./src",
    "release": "release-it && npm run build:ext",
    "fontlist": "ts-node-transpile-only export-font-list.ts",
    "add-font": "ts-node-transpile-only add-google-font.ts",
    "postinstall": "patch-package"
  },
  "author": "nopol10",
  "license": "gpl-3.0",
  "devDependencies": {
    "@babel/cli": "7.28.3",
    "@babel/core": "7.29.7",
