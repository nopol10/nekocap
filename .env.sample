NEXT_PUBLIC_FIREBASE_API_KEY=
# The auth domain has to be your site's domain if you are not hosting on Firebase itself with a Firebase domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_PARSE_APP_ID=
NEXT_PUBLIC_PARSE_SERVER_URL=
# Base URL of the NekoCap API server (e.g. https://api.nekocap.com). All
# requests go to its REST API under /api/v1. The Parse values above are still
# needed as the Parse SDK keeps the logged in user's session.
NEXT_PUBLIC_NEKOCAP_API_URL=
# Optional: URL for the NextJS server (backend only) to reach the NekoCap API,
# like PARSE_INTERNAL_SERVER_URL. Defaults to NEXT_PUBLIC_NEKOCAP_API_URL.
NEKOCAP_INTERNAL_API_URL=
NEXT_PUBLIC_EXTENSION_ID=
NEXT_PUBLIC_SENTRY_DSN=
PARSE_INTERNAL_SERVER_URL=
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_FONTS_URL=
# Google OAuth Client ID is needed for the Firefox extension
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Dev-only: set to "true" to keep the extension working without the Firebase
# values above (login won't work). Never set this in a real/published build.
NEXT_PUBLIC_SKIP_FIREBASE_AUTH_INIT=
NEXT_HOSTNAME=
# These are for use with the sample server.js
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=
